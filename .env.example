# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 않습니다.
# OpenAI API 키
OPENAI_API_KEY=
# OpenAI 호환 게이트웨이를 쓸 때만 입력 (비우면 OpenAI 기본 주소)
# OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# 위키백과 API 호출 시 User-Agent에 넣을 연락처 (위키미디어 정책)
WIKI_CONTACT=
# 공공데이터포털 일반 인증키(Decoding) — 리콜 데이터 수집용
DATA_GO_KR_KEY=
CHROMA_DIR=./chroma_db
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
# 근거 검색 방식: similarity(기본) 또는 mmr. 비교 결과는 docs/MMR_비교.md
SEARCH_TYPE=similarity
MMR_FETCH_K=30
MMR_LAMBDA=0.5
